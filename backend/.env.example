DB_HOST=localhost
DB_PORT=5432
DB_NAME=agrisense_db
DB_USER=postgres
DB_PASSWORD=your_password_here
JWT_SECRET=your_jwt_secret_here
PORT=5000

# Google Gemini AI Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODEL=gemini-3.8-flash

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/agrisense_mongo
MONGODB_DATABASE=agrisense_mongo

# OpenWeather API
OPENWEATHER_API_KEY=your_api_key_here
OPENWEATHER_BASE_URL=https://api.openweathermap.org/data/2.5

# Optional Sentinel Hub Statistical API (Sentinel-2 L2A, 10 m red/NIR inputs)
# Satellite processing stays disabled until both credentials are configured.
SENTINEL_HUB_CLIENT_ID=
SENTINEL_HUB_CLIENT_SECRET=
SENTINEL_HUB_TOKEN_URL=https://identity.dataspace.copernicus.eu/auth/realms/CDSE/protocol/openid-connect/token
SENTINEL_HUB_STATISTICS_URL=https://sh.dataspace.copernicus.eu/statistics/v1
