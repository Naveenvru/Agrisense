# AgriSense AI Service — Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# ============================================================
# API Keys
# ============================================================
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# ============================================================
# Kaggle Credentials (for dataset download)
# ============================================================
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_api_key

# ============================================================
# Database Connections (match NestJS backend .env)
# ============================================================
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=agrisense
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=agrisense
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_DB=agrisense

# ============================================================
# ChromaDB
# ============================================================
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION_MARKET=agrisense_market_docs
CHROMA_COLLECTION_AGRI=agrisense_agri_knowledge

# ============================================================
# AI Service Configuration
# ============================================================
AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=8000
LOG_LEVEL=INFO
ENVIRONMENT=development

# ============================================================
# NestJS Backend (for internal communication)
# ============================================================
NESTJS_BACKEND_URL=http://localhost:3000
NESTJS_INTERNAL_API_KEY=your_internal_api_key_here

# ============================================================
# Model Artifacts
# ============================================================
MODEL_ARTIFACTS_DIR=./artifacts
DATA_DIR=./data

# ============================================================
# LLM Provider Selection
# ============================================================
# Options: gemini | openai
LLM_PROVIDER=gemini
LLM_MODEL_GEMINI=gemini-1.5-flash
LLM_MODEL_OPENAI=gpt-4o-mini

# ============================================================
# Feature Flags
# ============================================================
ENABLE_PRICE_FORECASTING=true
ENABLE_DISEASE_DETECTION=true
ENABLE_RAG=true
ENABLE_LLM_EXPLANATIONS=true
# Set to false for offline/development without API keys:
ENABLE_EXTERNAL_LLMS=false

