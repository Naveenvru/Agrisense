# Public map-service URLs only. Configure a provider that permits your traffic and deployment.
# The built-in OpenStreetMap and Esri URLs are development defaults with provider limits/terms.
VITE_STREET_TILE_URL=
VITE_STREET_TILE_ATTRIBUTION=
VITE_SATELLITE_TILE_URL=
VITE_SATELLITE_TILE_ATTRIBUTION=
VITE_TERRAIN_TILE_URL=
VITE_TERRAIN_TILE_ATTRIBUTION=
# Optional user-triggered geocoder endpoint; default is public Nominatim.
VITE_GEOCODING_URL=
