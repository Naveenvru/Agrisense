# ==============================================================================
# AgriSense — Enterprise Git Ignore Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment & Sensitive Credentials
# ------------------------------------------------------------------------------
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
**/.env
**/.env.*
!.env.example
!**/.env.example

# Private Keys & Certificates
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12

# ------------------------------------------------------------------------------
# 2. Dependencies & Package Managers
# ------------------------------------------------------------------------------
node_modules/
*/node_modules/
**/node_modules/
.pnp
.pnp.js

# ------------------------------------------------------------------------------
# 3. Build & Compilation Outputs
# ------------------------------------------------------------------------------
dist/
*/dist/
**/dist/
dist-ssr/
build/
*/build/
out/
.next/
.nuxt/
.cache/

# TypeScript Build Info
*.tsbuildinfo
tsconfig.tsbuildinfo
tsconfig.build.tsbuildinfo
**/tsconfig.build.tsbuildinfo

# ------------------------------------------------------------------------------
# 4. Python & Virtual Environments
# ------------------------------------------------------------------------------
__pycache__/
*/__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
venv/
*/venv/
.venv/
*/.venv/
env/
*/env/
ENV/
env.bak/
venv.bak/

# Testing & Coverage
.pytest_cache/
*/.pytest_cache/
**/.pytest_cache/
.coverage
.coverage.*
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
htmlcov/
/.nyc_output

# Jupyter Notebook Checkpoints
.ipynb_checkpoints/
*/.ipynb_checkpoints/
**/.ipynb_checkpoints/

# ------------------------------------------------------------------------------
# 5. Machine Learning, Vector DB & Runtime Caches
# ------------------------------------------------------------------------------
# CatBoost Training Logs
catboost_info/
*/catboost_info/
**/catboost_info/

# ChromaDB & SQLite Runtime Storage (Auto-generated by RAG at runtime)
chroma_db/
*/chroma_db/
**/chroma_db/
ai-service/ai-service/
*.sqlite3
*.sqlite3-journal

# Weights & Biases / MLflow / TensorBoard
wandb/
mlruns/
lightning_logs/

# ------------------------------------------------------------------------------
# 6. Logs & Debug Artifacts
# ------------------------------------------------------------------------------
logs/
*/logs/
**/logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# ------------------------------------------------------------------------------
# 7. Operating System & Editor Specific
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msix
*.msm
*.msp
*.lnk

# Linux
*~
.fuse_hidden*
.directory
.Trash-*

# IDEs & Editors
.idea/
*.sublime-workspace
*.sublime-project
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.c9/
.settings/
.project
.classpath

# VS Code (preserve extensions and shared recommendations)
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
